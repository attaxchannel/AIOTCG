# ===== AIOTCG - Self-Hosted Vault Fallback =====
# Preferred: add keys in-app at /settings 🔑 (no .env needed). These are fallback if vault empty.
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://aitcg:aitcg@postgres:5432/aitcg
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=aiotcg
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=llama3-70b-8192
WHISPER_MODEL=large-v3
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# OAuth placeholders (also in-app vault)
CLINE_TOKEN=
ANTIGRAVITY_TOKEN=
