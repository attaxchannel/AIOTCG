  "shortcuts": [
    { "name": "Auto Generate", "url": "/?action=auto", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Projects", "url": "/jobs", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
