# Frontend — where the PWA talks to studio backend
# This is the ONLY env that makes the web interactive (all fetches + WebSockets use it)
NEXT_PUBLIC_API_URL=http://localhost:8000
# For phone: set to your Railway/Render/RunPod URL or PC LAN IP e.g. http://192.168.1.50:8000
# Or on Vercel/Netlify: set in Project Settings → Environment Variables → NEXT_PUBLIC_API_URL (then Redeploy)
# Interactive on-device override (no rebuild): Chrome console → localStorage.setItem('NEXT_PUBLIC_API_URL','https://new-backend.com'); location.reload()
